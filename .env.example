# Copia a .env y rellena los valores. Genera un secreto con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

JWT_SECRET=pega_aqui_un_token_urlsafe_largo
ENCRYPTION_KEY=pega_aqui_un_base64_urlsafe_32_bytes

# Conexión a PostgreSQL (Docker Compose la sobrescribe con el nombre del servicio `db`)
DATABASE_URL=postgresql://bot:bot123@localhost:5432/binance_bot

# true = simulación (sin dinero real) | false = operación real con keys de Binance
MOCK_MODE=true

# true = usa API de testnet de Binance
USE_TESTNET=true

# true = datos/saldo reales de Binance pero órdenes simuladas (no envía órdenes reales)
DRY_RUN=false

# --- Arbitraje de funding (spot long + perp short, delta-neutral) ---
# Requiere API de futuros USDⓈ-M. Empieza siempre con DRY_RUN=true y FUNDING_ENABLED=false.
FUNDING_ENABLED=false
FUNDING_MIN_ANNUAL_PCT=8.0
FUNDING_NOTIONAL_USDT=100
FUNDING_LEVERAGE=1
FUNDING_EXIT_IF_NEGATIVE=true
FUNDING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Gate de entrada: funding sostenido, sin pico extremo, basis acotado y sin FOMC/CPI.
FUNDING_MIN_INTERVALS=3
FUNDING_MAX_ZSCORE=2.5
FUNDING_MAX_BASIS_PCT=0.5
FUNDING_HISTORY_WINDOW=30
FUNDING_EVENT_BLACKOUT_MINUTES=120
FUNDING_MIN_HOLD_DAYS=7
FUNDING_MAKER_TIMEOUT_SECONDS=20

# Paralelismo del entrenamiento ML (-1 = todos los cores). En máquinas con
# poca RAM, usa ML_NJOBS=2 para evitar el thrashing de los 16 workers.
ML_NJOBS=-1

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Hash SHA256 del modelo ML para verificación de integridad (generar tras entrenar)
# MODEL_INTEGRITY_HASH=sha256:...

# --- PostgreSQL (usado por docker-compose) ---
POSTGRES_USER=bot
POSTGRES_PASSWORD=botpass123
POSTGRES_DB=binance_bot

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Notificaciones (opcionales) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Análisis de sentimiento (opcional, NewsAPI) ---
SENTIMENT_ENABLED=false
SENTIMENT_API_KEY=
SENTIMENT_CACHE_TTL=900

# --- Monitoring ---
GRAFANA_PASSWORD=admin123

# --- Backups (opcionales) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
S3_BUCKET=
S3_PREFIX=botbinance-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Deploy CI/CD (usados como GitHub Secrets, no en .env) ---
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_PATH=/opt/botbinance
# DEPLOY_SSH_KEY=
# DEPLOY_KNOWN_HOSTS=

